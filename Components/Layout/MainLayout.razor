@inherits LayoutComponentBase

<div class="page">
    <header class="site-header">
        <div class="header-inner">
            <a class="brand" href="/" aria-label="Azure Cosmos DB Distributed Transactions home">
                <span class="brand-symbol" aria-hidden="true">✦</span>
                <span>Azure Cosmos DB <span class="brand-divider">/</span> Distributed Transactions</span>
            </a>
            <span class="header-label">Interactive demo</span>
        </div>
    </header>
    <main>
        <article class="content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
